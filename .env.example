# Copiez ce fichier en .env et ajustez si besoin.

# --- Mode d'exécution ---
# true  = données synthétiques (démarrage immédiat, hors-ligne)
# false = vraies API (satellite STAC gratuit, OSM, scraping)
DEMO_MODE=true

# --- Base PostGIS ---
POSTGRES_USER=djiland
POSTGRES_PASSWORD=djiland
POSTGRES_DB=ivoire_land
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Partage à distance : mot de passe d'accès (optionnel) ---
# Si défini, le dashboard demande ce mot de passe avant d'afficher quoi que ce soit.
# Indispensable avant d'exposer l'app sur Internet (tunnel / déploiement).
# Laissez vide pour un usage local sans mot de passe.
DJILAND_PASSWORD=

# --- Base en ligne PERMANENTE pour prix réels + notes (optionnel) ---
# Adresse PostgreSQL gratuite (Neon recommandé) — voir PERSISTANCE.md.
# Vide = fichiers locaux data/grand_abidjan/*.parquet. Ne JAMAIS committer la vraie valeur.
DJILAND_DB_URL=

# --- Aucune clé payante requise ---
# Sentinel-2/Landsat : Element84 Earth Search (public, sans clé).
# Sentinel-1/DEM     : Microsoft Planetary Computer (token signé automatiquement).
